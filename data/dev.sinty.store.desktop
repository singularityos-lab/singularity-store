[Desktop Entry]
Version=1.0
Type=Application
Name=Store
Comment=Browse and install applications
Exec=singularity-store
Icon=dev.sinty.store
Terminal=false
Categories=System;PackageManager;
Keywords=install;apps;flathub;flatpak;update;
StartupNotify=true
StartupWMClass=dev.sinty.store
Actions=updates;installed;

[Desktop Action updates]
Name=Updates
Exec=singularity-store --updates

[Desktop Action installed]
Name=Installed Apps
Exec=singularity-store --installed
